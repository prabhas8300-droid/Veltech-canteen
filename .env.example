# ============================================================
# Annapurna Canteen – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3000

# JWT (change this to a long random secret in production)
JWT_SECRET=AnnapurnaVelTech2026SecretKey!@#

# Admin bootstrap secret
ADMIN_SECRET=VelTechAdmin2026

# ---- Razorpay Payment Gateway ----
# Sign up at https://dashboard.razorpay.com and get your keys.
# Leave RAZORPAY_KEY_ID empty to run in DEVELOPMENT MODE (simulated payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Development Mode ----
# When RAZORPAY_KEY_ID is empty the app runs in DEV mode:
# - Payments are simulated (never actually charged).
# - A clearly labeled "⚠️ DEV MODE" banner is shown at checkout.
# - Orders are saved with payment_status = "dev_simulated".
